# Template for /data/apps/limen/.env (mode 600). Names and placeholders only.
# POSTGRES_PASSWORD: letters and digits only, it is spliced into DATABASE_URL.
#   openssl rand -hex 24
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://limen:<POSTGRES_PASSWORD>@postgres:5432/limen

AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Behind Traefik and the Cloudflare Tunnel.
TRUST_PROXY=true

# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP_DAYS=14
