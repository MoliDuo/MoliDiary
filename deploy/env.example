# Template for /data/apps/diary/.env (mode 600). Names and placeholders only.
# POSTGRES_PASSWORD: letters and digits only, it is spliced into DATABASE_URL.
#   openssl rand -hex 24
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://diary:<POSTGRES_PASSWORD>@postgres:5432/moli-diary-db

AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Authelia sign-in (standard 008, P1). The administrator registers the client
# (MoliSpec docs/sop/authelia-登记客户端.md); the secret is shown once and goes here.
OIDC_ISSUER=https://auth.xiangyu.pro
OIDC_CLIENT_ID=moli-diary
OIDC_CLIENT_SECRET=
APP_ORIGIN=https://diary.xiangyu.pro

# Behind Traefik and the Cloudflare Tunnel.
TRUST_PROXY=true

# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP_DAYS=14
