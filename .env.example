# Postgres 16 or newer. For development, `docker compose -f docker-compose.local.yml up -d`
# starts one that matches this URL.
DATABASE_URL=postgresql://diary:diary@127.0.0.1:5432/moli-diary-db

AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini

# Sign-in through Authelia (Moli standard 008, P1). Leave all four unset for local
# development: with no OIDC settings outside production the app lets you in as a
# development administrator. In production the server's .env holds the real values;
# OIDC_CLIENT_SECRET comes from the administrator's client registration and never
# goes in the repository.
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=moli-diary
# OIDC_CLIENT_SECRET=test-secret
# APP_ORIGIN=https://diary.example.com

# Set to true only behind reverse proxies you run (Traefik, Cloudflare Tunnel).
# PIN rate limiting then keys on the first public address in X-Forwarded-For
# counted from the right; without it every failure shares one bucket.
TRUST_PROXY=false

# Optional tuning: AI_CONCURRENCY=2, AI_TIMEOUT_MS=120000, AI_MAX_RETRIES=3,
# DATABASE_POOL_MAX=10, DATABASE_STATEMENT_TIMEOUT_MS=30000.

ALLOWED_DEV_ORIGINS=localhost,192.0.2.1
