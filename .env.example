# Password for the bundled Postgres. Letters and digits only: it is spliced
# into DATABASE_URL. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini

# Set to true only behind a reverse proxy that overwrites X-Forwarded-For
# (the bundled Caddy does). Login rate limiting is keyed on that address.
TRUST_PROXY=false

# Database backups: how often, and how many days to keep (written to ./backups).
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
# Owner of ./backups on the host (see `id -u` / `id -g`).
BACKUP_UID=1000
BACKUP_GID=1000

# Host port for the app (bound to 127.0.0.1), and the domain Caddy serves.
APP_PORT=3000
# DOMAIN=diary.example.com

ALLOWED_DEV_ORIGINS=localhost,192.168.1.100
