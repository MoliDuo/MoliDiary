# Postgres 16 or newer. For development, `docker compose -f docker-compose.local.yml up -d`
# starts one that matches this URL.
DATABASE_URL=postgresql://diary:diary@127.0.0.1:5432/moli-diary-db

AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini

# Set to true only behind reverse proxies you run (Traefik, Cloudflare Tunnel).
# Login rate limiting then keys on the first public address in X-Forwarded-For
# counted from the right; without it every failure shares one bucket.
TRUST_PROXY=false

# Optional tuning: AI_CONCURRENCY=2, AI_TIMEOUT_MS=120000, AI_MAX_RETRIES=3,
# DATABASE_POOL_MAX=10, DATABASE_STATEMENT_TIMEOUT_MS=30000.

ALLOWED_DEV_ORIGINS=localhost,192.0.2.1
